PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/careerpulse
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173,https://your-frontend.vercel.app
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
GEMINI_MODEL=gemini-1.5-flash
# Timeout per LLM attempt (default: 8000 on Vercel, 30000 local)
LLM_TIMEOUT_MS=8000
# Total shared budget before falling back to rule-based engine (default: 9000 on Vercel, 30000 local)
LLM_TOTAL_BUDGET_MS=9000
